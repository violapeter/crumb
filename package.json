{
  "name": "crumbjs",
  "version": "2.1.0",
  "main": "lib/cjs/index.js",
  "author": {
    "name": "Péter Viola",
    "email": "info@violapeter.hu",
    "url": "https://violapeter.hu"
  },
  "license": "MIT",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watchAll",
    "build": "tsc -p .buildconfig/tsconfig.mjs.json && tsc -p .buildconfig/tsconfig.cjs.json && .buildconfig/fixup",
    "build:cli": "tsc --project .buildconfig/tsconfig.cli.json",
    "start": "node ./lib/cli/src/cli/index.js",
    "dev": "tsx ./src/cli/index.ts",
    "package": "pkg . --out-path=bin",
    "type-check": "tsc -p .buildconfig/tsconfig.json --noEmit"
  },
  "bin": {
    "crumb": "lib/cli/src/cli/index.js"
  },
  "devDependencies": {
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@yao-pkg/pkg": "^6.22.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "module": "lib/mjs/index.js",
  "exports": {
    ".": {
      "import": "./lib/mjs/index.js",
      "require": "./lib/cjs/index.js"
    }
  },
  "types": "./types.d.ts",
  "files": [
    "lib",
    "src",
    "index.ts",
    "types.d.ts"
  ],
  "pkg": {
    "targets": [
      "node24-linux-x64",
      "node24-macos-x64",
      "node24-win-x64"
    ],
    "outputPath": "bin"
  },
  "jest": {
    "transform": {
      "^.+\\.ts$": [
        "@swc/jest",
        {
          "jsc": {
            "parser": {
              "syntax": "typescript"
            },
            "target": "esnext"
          },
          "module": {
            "type": "commonjs"
          }
        }
      ]
    },
    "testMatch": [
      "**/__tests__/*.spec.ts"
    ],
    "moduleFileExtensions": [
      "js",
      "ts"
    ]
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "semi": false
  }
}
